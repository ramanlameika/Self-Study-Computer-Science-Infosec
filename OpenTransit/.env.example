# OpenTransit Environment Configuration
# Copy this file to .env and fill in real values before running.

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
QR_SECRET_KEY=change-me-qr-in-production

# ── Payment Providers ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── External Services ────────────────────────────────────────────────────────
# Set to your SMTP server for notifications
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_SANDBOX_MODE=true
ENABLE_RATE_LIMITING=true
